  steps:
  - kind: 14
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: scientist.computer_subject_has_escaped
    text: Computer, subject has escaped containment. Request advice.
    speaker: 
    target: {fileID: 1281597936}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: computer.with_a_firm_tone
    text: With a firm tone of voice, demand subject lie down on the ground, hands
      behind their back.
    speaker: 
    target: {fileID: 1652506811}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: scientist.lie_down_on_the_ground
    text: Lie down on the ground. Hands behind your back.
    speaker: 
    target: {fileID: 1281597936}
    cutscene: {fileID: 0}
  - kind: 0
    seconds: 0.8
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: scientist.subject_did_not_comply
    text: Subject did not comply.
    speaker: 
    target: {fileID: 1281597936}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: computer.approach_and_repeat
    text: 'Approach and repeat ultimatum in even firmer tone of voice and add at
      the end: or else.'
    speaker: 
    target: {fileID: 1652506811}
    cutscene: {fileID: 0}
  - kind: 15
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 10
    seconds: 90
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 2
    seconds: 0
    id: pa.code_silver
    text: Attention. Code silver. Non-security personnel, shelter in place.
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
  doneFlag: ultimatum_done
