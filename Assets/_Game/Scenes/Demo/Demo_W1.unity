  m_Script: {fileID: 11500000, guid: 85611ea943b47f923be938cea756c64c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlorifiedBody.Story.ScriptedSequence
  steps:
  - kind: 6
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 1959554042}
    cutscene: {fileID: 0}
  - kind: 0
    seconds: 0.6
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs02_00
    text: Computer. Subject has escaped containment. Request advice.
    speaker: SCIENTIST
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs02_01
    text: With a firm tone of voice, demand the subject lie down on the ground, hands
      behind their back.
    speaker: COMPUTER
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs02_02
    text: Lie down on the ground. Hands behind your back.
    speaker: SCIENTIST
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs02_03
    text: Subject did not comply.
    speaker: SCIENTIST
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs02_04
    text: 'Approach the subject and repeat the ultimatum in an even firmer tone of
      voice. Add at the end: "or else".'
    speaker: COMPUTER
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs02_05
    text: Lie down. On the ground. Hands behind your back.
    speaker: SCIENTIST
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs02_06
    text: Or else.
    speaker: SCIENTIST
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 8
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 1959554042}
