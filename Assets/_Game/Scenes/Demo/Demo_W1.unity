MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 176042783}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 85611ea943b47f923be938cea756c64c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlorifiedBody.Story.ScriptedSequence
  steps:
  - kind: 3
    seconds: 0
    id: feed_locked
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 10
    seconds: 88
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 14
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 0
    seconds: 1
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs01_00
    text: Lucy.
    speaker: STEVENS
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs01_01
    text: Your name is Lucy.
    speaker: STEVENS
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs01_02
    text: You're confused. You're dizzy. That's normal, and I can't fix it.
    speaker: STEVENS
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs01_03
    text: Neither of us has much time.
    speaker: STEVENS
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs01_04
    text: The screen by the door.
    speaker: STEVENS
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs01_05
    text: The part in red. Nobody's finished it. There are no cameras in there. I'll
      make sure it's empty.
    speaker: STEVENS
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs01_06
    text: Take the sheet.
    speaker: STEVENS
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs01_07
    text: I can't walk you there. You'll have to find your own way.
    speaker: STEVENS
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 15
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
  doneFlag: demo_w1_wake
  runOnStart: 1
