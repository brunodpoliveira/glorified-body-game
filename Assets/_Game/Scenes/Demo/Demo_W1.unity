  m_EditorClassIdentifier: Assembly-CSharp::GlorifiedBody.Story.ScriptedSequence
  steps:
  - kind: 6
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 1156324692}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 20
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 1156324692}
    cutscene: {fileID: 0}
    point: {x: 4, y: 0, z: 13.85}
  - kind: 0
    seconds: 0.6
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs02_00
    text: Computer. Subject has escaped containment. Request advice.
    speaker: SCIENTIST
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs02_01
    text: With a firm tone of voice, demand the subject lie down on the ground, hands
      behind their back.
    speaker: COMPUTER
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs02_02
    text: Lie down on the ground. Hands behind your back.
    speaker: SCIENTIST
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs02_03
    text: Subject did not comply.
    speaker: SCIENTIST
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs02_04
    text: 'Approach the subject and repeat the ultimatum in an even firmer tone of
      voice. Add at the end: "or else".'
    speaker: COMPUTER
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 20
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 1156324692}
    cutscene: {fileID: 0}
    point: {x: 4, y: 0, z: 14.7}
  - kind: 1
    seconds: 0
    id: cs02_05
    text: Lie down. On the ground. Hands behind your back.
    speaker: SCIENTIST
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs02_06
    text: Or else.
    speaker: SCIENTIST
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 8
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 1156324692}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
