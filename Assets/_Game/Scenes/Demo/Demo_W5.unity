    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs03_00
    text: Attention all personnel. Code silver.
    speaker: PA
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs03_01
    text: The building is under an active shooter alert. Code silver.
    speaker: PA
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs03_02
    text: Non-security personnel, shelter in place until further instructions.
    speaker: PA
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs03_03
    text: Security personnel, respond.
    speaker: PA
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs03_04
    text: Patients, please stay in your rooms. A member of staff will come to you.
    speaker: PA
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 3
    seconds: 0
    id: code_silver
