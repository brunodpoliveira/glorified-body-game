    text: '[PLACEHOLDER: the brain sector (B1) is built later.]'
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
