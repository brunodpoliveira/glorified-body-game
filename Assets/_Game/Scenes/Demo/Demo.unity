  m_Script: {fileID: 11500000, guid: 85611ea943b47f923be938cea756c64c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlorifiedBody.Story.ScriptedSequence
  steps:
  - kind: 14
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs11_01
    text: Miss? Miss, you can't... You've got no face on.
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs11_02
    text: Here. Hold on. We sell them, here, take one, no charge.
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs11_03
    text: ...Bare-faced.
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs11_04
    text: Okay. Okay, that's, uh. That's you.
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs11_05
    text: I'm not gonna do anything. I'm just gonna...
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs11_06
    text: I'm calling... I was calling...
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 25
    seconds: 0
    id: Attendant
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs11_07
    text: Who was I calling?
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 13
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 11400000, guid: a6697ecb567bdb8a0848a1dc3bc4201e, type: 2}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs11_08
    text: Get up.
    speaker: LUCY
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 3
    seconds: 0
    id: mk_edgar_unlocked
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 26
    seconds: 0
    id: Attendant
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs11_09
    text: ...Yes.
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs11_10
    text: Tell me where.
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs11_11
