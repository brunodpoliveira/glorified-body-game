    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 14
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11a_00
    text: You will obey!
    speaker: QUEEN
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11a_01
    text: "Who was I \u2014 I had the, I was calling somebody, who was I..."
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
