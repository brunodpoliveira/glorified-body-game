--- !u!114 &1398112397
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1398112396}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 85611ea943b47f923be938cea756c64c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlorifiedBody.Story.ScriptedSequence
  steps:
  - kind: 1
    seconds: 0
    id: cs05_00
    text: Lucy.
    speaker: MARTA
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs05_01
    text: Lucy, it's Marta.  (S2. A breath) I taught you to hold a cup.
    speaker: MARTA
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs05_02
    text: You don't remember. You never do, the first day.
    speaker: MARTA
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs05_03
    text: It's all right. Nobody's going to hurt you.  (a beat) Not anymore.
    speaker: MARTA
