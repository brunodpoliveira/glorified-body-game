  steps:
  - kind: 0
    seconds: 1.5
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs03_00
    text: Attention. Code silver. Code silver, south corridor. Active shooter in
      the building.
    speaker: PA
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 33
    seconds: 1
    id: cs03_01
    text: ...twenty-two, twenty-three, twenty-four, twenty-five...
    speaker: 
    target: {fileID: 464192913}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 33
    seconds: 0
    id: cs03_02
    text: ...twenty-six, twenty-seven, twenty-eight, twenty-nine, thirty. Come on.
      One, two, three...
    speaker: 
    target: {fileID: 464192913}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs03_03
    text: Non-security staff, shelter in place until further instructions. Security,
      respond to the south corridor.
    speaker: PA
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 33
    seconds: 0
    id: cs03_04
    text: ...nine, ten, eleven, twelve...
    speaker: 
    target: {fileID: 464192913}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs03_05
    text: Patients, please stay where you are. That is all you have to do.
    speaker: PA
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 33
    seconds: 0
    id: cs03_06
    text: ...twenty-eight, twenty-nine, thirty. Stay. Stay with me. One, two...
    speaker: 
    target: {fileID: 464192913}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs03_07
    text: Code silver. Code silver.
    speaker: PA
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 3
    seconds: 0
    id: code_silver
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
