    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: u1_b1_later
    text: '[PLACEHOLDER: the brain sector (B1) is built later.]'
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs10_00
    text: I was meant to be beautiful.
    speaker: BRAIN
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs10_01
    text: I didn't know that was in there.
    speaker: STEVENS
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
    id: cs10_02
    text: That's not an excuse.
    speaker: STEVENS
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
  - kind: 1
    seconds: 0
