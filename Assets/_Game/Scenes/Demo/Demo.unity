  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.88, g: 0.86, b: 0.8, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 36
    m_FontStyle: 1
    m_BestFit: 1
    m_MinSize: 8
    m_MaxSize: 36
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: 'RISER WORKS

    CAUTION: FLOOR OPEN

    Use the bridge board to cross.
    Do not step on the deck edge.

    Hard hat area. Contractor personnel only.

    WHO
    TOOK THE BOARD?? It was here Tuesday. And QUIT walking across on the crates,
    they are not rated for that and I am not doing the paperwork when one of you
    goes through to the slab. Whoever has it, put it BACK.'
