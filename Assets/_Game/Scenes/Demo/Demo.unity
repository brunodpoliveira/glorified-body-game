  m_Script: {fileID: 11500000, guid: 85611ea943b47f923be938cea756c64c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlorifiedBody.Story.ScriptedSequence
  steps:
  - kind: 5
    seconds: 0
    id: demo_r1_news_done
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 14
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11_01
    text: "Oh, hey, sorry, miss, I wasn't \u2014 you're fine. Coming down pretty
      good out there, huh."
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11_02
    text: "Here, just take one, don't worry about it. Happens. You're out the door
      and halfway down the block and \u2014 I've done it. Just, uh. Just take it."
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11_03
    text: "...approximately twenty. Gold color lines, at neck. Long curly light blonde
      \u2014"
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11_04
    text: "Okay. Okay, I'm not gonna \u2014 I'm not doing anything, ma'am, I'm just
      gonna, this is just the, I have to, it's a thing they \u2014 you're fine. You're
      fine."
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 15
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 31
    seconds: 1.1
    id: demo_r1_take
    text: Press {key} to take his mind. Walk to the back door to leave him.
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 67.6, y: 0, z: 21}
    otherFlag: demo_r1_leave
  - kind: 32
    seconds: 10
    id: demo_r1_take
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 14
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11a_00
    text: You will obey!
    speaker: QUEEN
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11a_01
    text: "Who was I \u2014 I had the, I was calling somebody, who was I..."
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 25
    seconds: 0
    id: Attendant
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 13
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 11400000, guid: a6697ecb567bdb8a0848a1dc3bc4201e, type: 2}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11a_02
    text: Get up.
    speaker: LUCY
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11a_03
    text: Yes.
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11a_04
    text: Where do I go.
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 3
    seconds: 0
    id: mk_edgar_unlocked
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 26
    seconds: 0
    id: Attendant
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 32
    seconds: 5
    id: demo_r1_leave
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 14
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11b_00
    text: "Yeah, hi, I \u2014 she's here. The one on your sheet, she's at the gas
      station on the river road, right now, she's \u2014 no, she's standing right
      \u2014"
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11b_01
    text: "Light coat, open, a shirt under it with a skull on it, a cap, dark glasses,
      hair's up in a bun, and she took one of my \u2014 one of the white ones, she's
      got that on now. It's her, it's the lines, the gold, on the neck, I \u2014"
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11b_02
    text: "She's going out the back, the service \u2014 toward the bridge. I said
      the bridge. She's \u2014"
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 3
    seconds: 0
    id: coda_attendant_called
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11z_00
    text: MK_EDGAR. ONE CAPSULE IDENTIFIED.
    speaker: READOUT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 3
    seconds: 0
    id: mk_edgar_unlocked
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
