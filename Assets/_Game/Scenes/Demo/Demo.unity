--- !u!114 &1177082161
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1177082160}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 85611ea943b47f923be938cea756c64c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlorifiedBody.Story.ScriptedSequence
  steps:
  - kind: 1
    seconds: 0
    id: cs06_00
    text: Hon. Stop right there, that's far enough. This isn't your room.
    speaker: WARD SISTER
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs06_01
    text: "You want out, that's the stairwell, back the way you came. I'll walk you
      myself, I don't\u2014"
    speaker: WARD SISTER
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs06_02
    text: "Sister, that's the shooter, that's the code, you heard what it did to\u2014"
    speaker: LAB WORKER
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs06_03
    text: "Sister, please, just say I can, just\u2014"
    speaker: LAB WORKER
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs06_04
    text: No. These are for the little ones.
    speaker: WARD SISTER
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  doneFlag: demo_w11_lab
  runOnStart: 0
  startsBlack: 0
