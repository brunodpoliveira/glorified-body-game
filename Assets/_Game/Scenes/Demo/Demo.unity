    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: 'INDUCTION SUITE 2

    PAIN MANAGEMENT PROTOCOL IN EFFECT

    AUTHORIZED
    PERSONNEL ONLY. KNOCK AND WAIT FOR THE DOOR TO BE OPENED.

