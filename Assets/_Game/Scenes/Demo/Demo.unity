  serializedVersion: 2
  m_LocalRotation: {x: 0, y: 0, z: 0, w: 1}
  m_LocalPosition: {x: 66.2, y: 2, z: 25.72}
  m_LocalScale: {x: 0.6, y: 0.4, z: 0.3}
