    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs03_03
    text: Non-security staff, shelter in place until further instructions. Security,
      respond to the south corridor.
    speaker: PA
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 33
    seconds: 0
