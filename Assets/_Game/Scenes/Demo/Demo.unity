  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 38732f8ed70b08f86b6401a11fceb82d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlorifiedBody.Interaction.Broadcast
  roomId: G10
  lines:
  - speaker: RADIO
    id: n1a_00
    text: ...my door is open to the union, tonight and every night until this ends.
      Until then the Guard has the streets, and I ask the people of this city for
      their patience through the holidays.
    picture: 
  - speaker: RADIO
    id: n1a_01
    text: The chief of police, earlier this evening. Sports now, and nobody saw this
      one coming. Dario Venn leaves Corwin Racing for Halberd Motorsport, with two
      years left on his contract.
    picture: 
  - speaker: RADIO
    id: n1a_02
    text: Corwin calls it a breach. Venn calls it a fresh start. More after this.
    picture: 
  byBand: []
  closing: []
  doneFlag: 
  loop: {fileID: 8300000, guid: e8b7564285e65e708bd3107d67d973cb, type: 3}
  loopVolume: 0.25
  pictures: {fileID: 0}
  afterComment: 
