    text: ...nine, ten, eleven, twelve...
    speaker: 
    target: {fileID: 1565933567}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs03_05
    text: Patients, please stay where you are. That is all you have to do.
    speaker: PA
    target: {fileID: 0}
