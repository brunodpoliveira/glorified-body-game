    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11_01
    text: "Oh, hey, sorry, miss, I wasn't \u2014 you're fine. Coming down pretty
      good out there, huh."
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11_02
    text: "Here, just take one, don't worry about it. Happens. You're out the door
      and halfway down the block and \u2014 I've done it. Just, uh. Just take it."
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11_03
    text: "...about twenty. Pale, real pale. Gold, thin \u2014 at the neck, yeah.
      Light blonde, curly, lo \u2014"
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs11_04
    text: "Okay. Okay, I'm not gonna \u2014 I'm not doing anything, ma'am, I'm just
      gonna, this is just the, I have to, it's a thing they \u2014 you're fine. You're
      fine."
    speaker: ATTENDANT
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 15
    seconds: 0
    id: 
    text: 
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 31
    seconds: 1.1
    id: demo_r1_take
    text: Press {key} to take his mind. Walk to the back door to leave him.
    speaker: 
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 67.6, y: 0, z: 21}
    otherFlag: demo_r1_leave
  - kind: 32
    seconds: 10
    id: demo_r1_take
