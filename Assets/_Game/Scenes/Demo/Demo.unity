  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.88, g: 0.86, b: 0.8, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 14
    m_FontStyle: 1
    m_BestFit: 1
    m_MinSize: 8
    m_MaxSize: 14
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: 'DANGER

    HALON 1301 FIRE SUPPRESSION SYSTEM IN THIS ROOM

    When
    the alarm horn sounds, the door will seal.

    The agent will discharge 30 seconds
    after the alarm.

    To stop the discharge, press EMERGENCY STOP on the control
    panel inside the room.

    Halon 1301 can cause loss of consciousness. Do not
    re-enter until the room has been ventilated.'
