  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlorifiedBody.Story.ScriptedSequence
  steps:
  - kind: 1
    seconds: 0
    id: cs05_00
    text: Lucy. It's Marta, it's just Marta, I'm not going anywhere, I'm going to
      stand right here with my hands where you can see them.
    speaker: MARTA
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs05_01
    text: I taught you to hold a cup. You don't remember that. You never do, not
      the first day, it's all gone, and I tell you anyway.
    speaker: MARTA
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  - kind: 1
    seconds: 0
    id: cs05_02
    text: "Okay. That's it, that's\u2014 Lucy, when you were little, I was\u2014
      I need you to know that I\u2014"
    speaker: MARTA
    target: {fileID: 0}
    cutscene: {fileID: 0}
    point: {x: 0, y: 0, z: 0}
    otherFlag: 
  doneFlag: demo_w9_marta
  runOnStart: 0
  startsBlack: 0
