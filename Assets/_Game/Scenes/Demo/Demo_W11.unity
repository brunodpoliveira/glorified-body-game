  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GlorifiedBody.Story.ScriptedSequence
  steps:
  - kind: 1
    seconds: 0
    id: cs06_00
    text: No. No, not in here.
    speaker: WARD SISTER
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs06_01
    text: These are for the little ones. Do you understand me? Not in here.
    speaker: WARD SISTER
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs06_02
    text: She's not listening. Sister, she doesn't listen.
    speaker: LAB WORKER
    target: {fileID: 0}
    cutscene: {fileID: 0}
  - kind: 1
    seconds: 0
    id: cs06_03
    text: Then we make her.
    speaker: WARD SISTER
    target: {fileID: 0}
    cutscene: {fileID: 0}
  doneFlag: demo_w11_lab
  runOnStart: 0
