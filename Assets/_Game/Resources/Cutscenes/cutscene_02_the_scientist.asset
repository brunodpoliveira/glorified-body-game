    panTo: {x: 0, y: 0, z: 1}
    speaker: SCIENTIST
    lineId: cs02_05
    text: I said lie down on the ground, hands behind your back.
  - still: {fileID: 2800000, guid: ac9c33c1e928167c79fe8e580e38f6ef, type: 3}
