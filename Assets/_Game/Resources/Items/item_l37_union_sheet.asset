  m_Script: {fileID: 11500000, guid: 202cb6532a4a7f80682b508098ca96f0, type: 3}
  m_Name: item_l37_union_sheet
  m_EditorClassIdentifier: Assembly-CSharp::GlorifiedBody.Interaction.ItemDefinition
  itemId: l37_union_sheet
  displayName: A SIGN-UP SHEET
  kind: 1
  drugType: 0
  colour: {r: 0.96, g: 0.95, b: 0.88, a: 1}
  description: a sign-up sheet.
  logText: "STAFF OF THE MEMORIAL \u2014\nYou have the right to ask for a union vote.\nThat's
    all this is. A vote. Sign here if you want one.\n[31 signatures, 4 crossed out]\nBy
    hand: Christmas was the last straw for me. 12 hr nights, no family, \"winter
    menu.\" done.\nBy hand: a union won't get you Christmas. talk to HR, they listened
    about the parking, didn't they?\nBy hand: HR works for them.\n\nFROM THE EXECUTIVE
    OFFICE\nTo every member of our family at the Memorial:\nWe've heard that some
    of you are talking about representation. We want you to know that our door is
    open, today and every day. We value direct conversation with each of you, and
    we always have. No third party knows your work, your patients or your hours as
    we do.\nIf something is wrong, tell us first. We will listen.\nWith gratitude,\nThe
    Executive Office"
  readFlag: 
  mapFloor: 
  audioClip: {fileID: 0}
  tapeLines: []
