  itemId: l25_winter_schedule
  displayName: A MEMO
  kind: 1
  drugType: 0
  colour: {r: 0.96, g: 0.95, b: 0.88, a: 1}
  description: a memo.
  logText: 'STAFF OFFICE. THE WINTER SCHEDULE. The Memorial keeps its normal schedule
    on 25 December and 1 January. Our feast is Future Day, in February, and on that
    day all staff rest with full pay. On 31 December the chapel is open all night.
    If you keep a private holiday in December, you may request leave, subject to
    cover. We know this season matters to many of you. Thank you for the hard days.


    By
    hand under it: Subject to cover. There is no cover. That''s the point.'
  readFlag: 
  mapFloor: 
  audioClip: {fileID: 0}
  tapeLines: []
