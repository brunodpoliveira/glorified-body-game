  itemId: log_n2_things_to_come
  displayName: THINGS TO COME
  kind: 6
  drugType: 0
  colour: {r: 0.95, g: 0.55, b: 0.2, a: 1}
  description: Her own voice, about the cartoon on the day room TV.
  logText: 
  readFlag: 
  mapFloor: 
  audioClip: {fileID: 0}
  tapeLines:
  - at: 0.4
    speaker: LUCY
    text: Aw, man.
    skipIfFlag: 
  - at: 2.04
    speaker: LUCY
    text: I tuned in right at the end!
    skipIfFlag: 
  - at: 4.7799997
    speaker: LUCY
    text: Things to Come is the best cartoon I've ever seen.
    skipIfFlag: 
  - at: 8.73
    speaker: LUCY
    text: Like Starship Troopers, you can watch it for the pew-pew space lasers,
      or as a meditation on progress and technology.
    skipIfFlag: 
  - at: 15.929999
    speaker: LUCY
    text: And this one is clearly on the side of the man in the arena, as Roosevelt
      said.
    skipIfFlag: 
  - at: 21.474998
    speaker: LUCY
    text: Well, I can ask a nurse to put in the Blu-ray so I can catch up later.
    skipIfFlag: 
