  m_Script: {fileID: 11500000, guid: 202cb6532a4a7f80682b508098ca96f0, type: 3}
  m_Name: item_l17_health_note
  m_EditorClassIdentifier: Assembly-CSharp::GlorifiedBody.Interaction.ItemDefinition
  itemId: l17_health_note
  displayName: AN OCCUPATIONAL HEALTH NOTE
  kind: 1
  drugType: 0
  colour: {r: 0.96, g: 0.95, b: 0.88, a: 1}
  description: an occupational health note.
  logText: "OCCUPATIONAL HEALTH\nTo: Facilities\nRe: Halon 1301, server room \u2014
    read before working in this room\n\nI am leaving this on the clipboard because
    this is where it needs to be read.\n\nBelow 10 percent, halon 1301 feels like
    being drunk. At 15 to 20 percent, people lose consciousness. In a fire it also
    breaks down into hydrogen fluoride and hydrogen bromide, which you cannot breathe
    at any level.\n\nThis room was designed for about 6 percent. The partition took
    two thirds of the room and nobody changed the cylinders. By facilities' own numbers
    a discharge in here now gives about 18 percent.\n\nWhen the horn sounds, the
    door seals to hold the agent in. The discharge follows 30 seconds later. The
    EMERGENCY STOP button on this panel is the only way to stop it. Not the door.
    The door is part of the system.\n\nYou will not know you are going under."
  readFlag: 
  mapFloor: 
  audioClip: {fileID: 0}
  tapeLines: []
