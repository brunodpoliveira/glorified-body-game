  itemId: l17_health_note
  displayName: AN OCCUPATIONAL HEALTH NOTE
  kind: 1
  drugType: 0
  colour: {r: 0.96, g: 0.95, b: 0.88, a: 1}
  description: an occupational health note.
  logText: OCCUPATIONAL HEALTH, TO FACILITIES. Below 10 percent, halon 1301 feels
    like being drunk. At 15 to 20 percent, people lose consciousness. In a fire it
    also breaks down into hydrogen fluoride and hydrogen bromide. This room was designed
    for about 6 percent. The partition took two thirds of the room, and nobody changed
    the cylinders. My number is now 18. The door seals on the horn to hold the agent
    in. ABORT is the only way out. You will not know you are going under.
  readFlag: 
  mapFloor: 
  audioClip: {fileID: 0}
  tapeLines: []
