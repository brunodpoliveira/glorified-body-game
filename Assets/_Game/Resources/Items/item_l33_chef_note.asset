  m_Name: item_l33_chef_note
  m_EditorClassIdentifier: Assembly-CSharp::GlorifiedBody.Interaction.ItemDefinition
  itemId: l33_chef_note
  displayName: A NOTE FROM THE CHEF
  kind: 1
  drugType: 0
  colour: {r: 0.96, g: 0.95, b: 0.88, a: 1}
  description: a note from the chef.
  logText: "TO THE LINE \u2014 READ IT\nSOMEBODY ASKS FOR A CHRISTMAS MENU, THEY
    GET THE WINTER MENU. YOU DO NOT SAY NO. YOU DO NOT SAY THE WORD. \"WINTER MENU,
    FOLKS, BEST ROAST IN THE COUNTY.\" THAT'S IT. MOVE ON.\nFUTURE DAY IS IN FEBRUARY.
    BEST NIGHT OF OUR YEAR, EVERY YEAR, AND I MEAN THAT. SAVE IT FOR THEN. YOU'LL
    SEE.\nPRIVATE RM GETS THE TASTING. NO SUBS. NOT ONE. I DON'T CARE WHO'S SITTING
    THERE.\nHANDS. CLEAN. ALWAYS.\n\u2014 CHEF\nturkey for the staff caf is in walk-in
    2 behind the stock. it is for GENE'S BIRTHDAY. NOBODY TOUCH IT. I mean it."
  readFlag: 
  mapFloor: 
  audioClip: {fileID: 0}
  tapeLines: []
