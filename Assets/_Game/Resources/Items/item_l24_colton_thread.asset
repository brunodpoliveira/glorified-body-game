  m_Name: item_l24_colton_thread
  m_EditorClassIdentifier: Assembly-CSharp::GlorifiedBody.Interaction.ItemDefinition
  itemId: l24_colton_thread
  displayName: A THREAD OF THREE EMAILS
  kind: 1
  drugType: 0
  colour: {r: 0.96, g: 0.95, b: 0.88, a: 1}
  description: a thread of three emails.
  logText: 'FROM: COLTON. 21 DEC. The tincture batch came in today, nine days late.
    I will not leave V3 for January. Day 0 is tomorrow, in one step, not the two-week
    ramp. Her mother agrees. I fly on the 23rd.


    FROM: WARD 2, STATION. 24 DEC.
    V3 does not know her name this morning. Or ours. Please call the ward.


    AUTO-REPLY:
    Dr. Colton is out of the office until 4 January, with his family. For urgent
    ward matters, contact the duty physician.'
  readFlag: 
  mapFloor: 
  audioClip: {fileID: 0}
  tapeLines: []
